# Copiar como .env y ajustar. Todo es opcional: sin este archivo el sistema
# genera solo una clave secreta en instance/secret.key y usa SQLite.

FLASK_APP=run.py

# SECRET_KEY: si se deja vacía, se genera automáticamente. No uses valores de ejemplo.
# SECRET_KEY=

# Base de datos (por defecto SQLite en instance/museo.db)
# DATABASE_URL=sqlite:///museo.db
# DATABASE_URL=postgresql://usuario:password@localhost:5432/museo_entradas

# Solo si se usa HTTPS con Caddy (iniciar_https.bat ya lo define)
# BEHIND_PROXY=1
# COOKIE_SECURE=1

# Segunda copia de cada respaldo (otro disco o carpeta sincronizada)
# BACKUP_EXTRA_DIR=E:\Respaldos\museo
